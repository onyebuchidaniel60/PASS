# PASS environment example. Copy values into the deploy platform; never commit
# real secrets. API variables are read by apps/api, web variables by apps/web.

# --- API -------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
DATABASE_PGLITE_PATH=./.pglite
SESSION_SECRET=
ENCRYPTION_KEY=

# Hyperliquid. Mock is the safe local default.
HYPERLIQUID_MODE=mock
HYPERLIQUID_READS_MODE=mock
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_EXCHANGE_URL=https://api.hyperliquid.xyz/exchange
# Protocol treasury / builder wallet that receives the 0.05% order fee.
# Leave blank for local mock testing; live orders then carry no builder fee.
HYPERLIQUID_BUILDER_ADDRESS=

ETHOS_MODE=mock
ETHOS_API_BASE_URL=
X_MODE=mock
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# NEAR Intents (mock returns deterministic quotes, no network).
NEAR_INTENTS_MODE=mock
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com
NEAR_INTENTS_JWT=
NEAR_INTENTS_DESTINATION_ASSET=

ENABLE_JOBS=false
SEED_DEMO_DATA=auto

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
