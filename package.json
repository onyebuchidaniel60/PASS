{
  "type": "module",
  "name": "pass",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @pass/web build && pnpm --filter @pass/extension build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @pass/db generate",
    "db:migrate": "pnpm --filter @pass/db migrate",
    "dev:api": "pnpm --filter @pass/api dev",
    "dev:web": "pnpm --filter @pass/web dev",
    "dev:worker": "pnpm --filter @pass/worker dev",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:tokens && pnpm run check:fonts",
    "check:tokens": "node scripts/check-design-tokens.mjs && node scripts/check-contrast.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "start": "pnpm --filter @pass/api start",
    "start:worker": "pnpm --filter @pass/worker start",
    "smoke": "node scripts/smoke.mjs",
    "smoke:approve-agent": "node scripts/smoke-approve-agent.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "keccak",
      "bufferutil",
      "utf-8-validate"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "next": "^15.1.3"
  }
}